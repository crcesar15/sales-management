{
  "description": "Impeccable design detector: runs after Edit/Write/apply_patch on UI files and surfaces findings as system reminders.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel)\"; script=\"$root/.agents/skills/impeccable/scripts/hook.mjs\"; [ -f \"$script\" ] || script=\"$root/.claude/skills/impeccable/scripts/hook.mjs\"; node \"$script\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ]
  }
}
